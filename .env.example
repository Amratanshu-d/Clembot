# Clembot Environment Configuration Example

# Active AI Provider: "heuristic" (100% offline rules), "gemini", "openai", "ollama"
CLEMBOT_AI_PROVIDER=heuristic

# AI Provider API Keys (Leave blank if using local heuristic or Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama Configuration (if using local Ollama model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Listening Mode
CLEMBOT_PUSH_TO_TALK=false
CLEMBOT_DEBUG=false
CLEMBOT_ALLOW_UNKNOWN_ACTIONS=false

# Local IPC Server Configuration (for VS Code Extension Bridge)
CLEMBOT_IPC_TOKEN=clembot-local-secure-token
