# Clembot Environment Configuration Example

# Active AI Provider: "heuristic" (100% offline rules), "gemini", "openai", "ollama"
CLEMBOT_AI_PROVIDER=heuristic

# AI Provider API Keys (Leave blank if using local heuristic or Ollama)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama Configuration (if using local Ollama model)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Listening Mode
CLEMBOT_PUSH_TO_TALK=false
CLEMBOT_DEBUG=false
CLEMBOT_ALLOW_UNKNOWN_ACTIONS=false

# Local IPC Server Configuration (for VS Code Extension Bridge)
CLEMBOT_IPC_TOKEN=clembot-local-secure-token

# ── Speech-to-Text (STT) Provider ────────────────────────────────────────────
# "google"  — Default. Uses Google Speech Recognition (requires internet).
# "whisper" — Offline, high-accuracy using faster-whisper (runs 100% locally).
#             First launch downloads the model (~40 MB for tiny.en). Fully offline after that.
CLEMBOT_STT_PROVIDER=google

# Whisper model size (only used when CLEMBOT_STT_PROVIDER=whisper):
#   tiny.en  — Fastest, ~40 MB, good accuracy for simple commands
#   base.en  — Better accuracy, ~145 MB, ~1.5s latency on CPU (recommended)
#   small.en — Higher accuracy, ~480 MB, ~3s latency on CPU
#   medium.en— Best accuracy, ~1.5 GB, requires a decent CPU or GPU
WHISPER_MODEL_SIZE=tiny.en

# Whisper inference device: "cpu" (default) or "cuda" (NVIDIA GPU required)
WHISPER_DEVICE=cpu

# Whisper compute type: "int8" (fastest on CPU), "float16" (GPU), "float32"
WHISPER_COMPUTE_TYPE=int8
